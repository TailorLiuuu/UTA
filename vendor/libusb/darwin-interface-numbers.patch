+/* UTA: bInterfaceNumber is an octet, not a descriptor-array index.
+ * Darwin needs all 256 values (including sparse modem interfaces >= 32).
+ * Keep other backends' existing mask ABI and limit unchanged. */
+#ifdef __APPLE__
+#define USB_MAXINTERFACES 256
+typedef struct { uint64_t words[4]; } usbi_interface_mask;
+static inline int usbi_interface_test(usbi_interface_mask mask, unsigned int n)
+{
+    return n < USB_MAXINTERFACES && (mask.words[n / 64] & (UINT64_C(1) << (n % 64)));
+}
+static inline void usbi_interface_set(usbi_interface_mask *mask, unsigned int n)
+{
+    if (n < USB_MAXINTERFACES) mask->words[n / 64] |= UINT64_C(1) << (n % 64);
+}
+static inline void usbi_interface_clear(usbi_interface_mask *mask, unsigned int n)
+{
+    if (n < USB_MAXINTERFACES) mask->words[n / 64] &= ~(UINT64_C(1) << (n % 64));
+}
+static inline int usbi_interface_empty(usbi_interface_mask mask)
+{
+    return !(mask.words[0] | mask.words[1] | mask.words[2] | mask.words[3]);
+}
+#else
+#define USB_MAXINTERFACES 32
+typedef unsigned long usbi_interface_mask;
+static inline int usbi_interface_test(usbi_interface_mask mask, unsigned int n)
+{
+    return n < USB_MAXINTERFACES && (mask & (1UL << n));
+}
+static inline void usbi_interface_set(usbi_interface_mask *mask, unsigned int n)
+{
+    if (n < USB_MAXINTERFACES) *mask |= 1UL << n;
+}
+static inline void usbi_interface_clear(usbi_interface_mask *mask, unsigned int n)
+{
+    if (n < USB_MAXINTERFACES) *mask &= ~(1UL << n);
+}
+#endif
